# NODE_ENV defaults to development. Set production in the deployment environment.
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:5173
# Local-only credentials; never use these on a hosted database.
DATABASE_URL=postgres://teamforge:teamforge_local@127.0.0.1:54329/teamforge
DATABASE_URL_DIRECT=postgres://teamforge:teamforge_local@127.0.0.1:54329/teamforge
TEST_DATABASE_URL=postgres://teamforge:teamforge_test@127.0.0.1:54330/teamforge_test
PG_POOL_MAX=20
# Generate a local secret with npm run env:setup; never use this placeholder.
JWT_SECRET=replace-with-at-least-32-random-bytes
# Empty means no trusted proxies. Set explicit IPs/CIDRs only after verifying the hosting topology.
TRUSTED_PROXY_CIDRS=
INVITE_TTL_HOURS=48
BOARD_CACHE_TTL_MS=1000
LOG_LEVEL=info
METRICS_TOKEN=replace-before-enabling-metrics
SEED_PASSWORD=demo-only-replace-before-seeding
